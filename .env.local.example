# ============================================================
# JobEscape Ops — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# -----------------------------------------------------------
# Google Sheets (source of truth)
# -----------------------------------------------------------
SHEETS_ID=1DDL55hP0yiTTH13Xexy_BJp6cv2WHfBf

# Separate spreadsheet for logs (Agreements, LegalReviews, NdaReviews tabs)
LOGS_SHEETS_ID=

# -----------------------------------------------------------
# Google Service Account (JSON as a single-line string)
# Get this from Google Cloud Console > IAM > Service Accounts
# Download the JSON key and paste its contents here
# IMPORTANT: replace actual newlines in private_key with \n
# -----------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"abc123","private_key":"-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n","client_email":"jobescape@your-project.iam.gserviceaccount.com","client_id":"123456789","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# -----------------------------------------------------------
# Google Drive folder IDs
# -----------------------------------------------------------

# Root folder for generated output (create a "Generated" parent folder and paste its ID)
DRIVE_ROOT_FOLDER_ID=

# Invoice DOCX templates folder
# https://drive.google.com/drive/folders/1YLUQhoeMiRRx131Yiej-NZ3isaNFFeBm
DRIVE_INVOICE_TEMPLATES_FOLDER_ID=1YLUQhoeMiRRx131Yiej-NZ3isaNFFeBm

# NDA DOCX templates folder
# https://drive.google.com/drive/folders/1amYDur_QK-rv-MVA6iD0PQTF4famrzLw
DRIVE_NDA_TEMPLATES_FOLDER_ID=1amYDur_QK-rv-MVA6iD0PQTF4famrzLw

# -----------------------------------------------------------
# PDF Conversion
# -----------------------------------------------------------

# CloudConvert API key (https://cloudconvert.com/api) — REQUIRED for Vercel deployment
# Buy prepaid credits at https://cloudconvert.com/pricing (~$0.002 per conversion)
CLOUDCONVERT_API_KEY=

# -----------------------------------------------------------
# LLM for Legal Review
# -----------------------------------------------------------

# Provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# API key for the selected provider
LLM_API_KEY=

# Model name
# For Anthropic: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5-20251001
# For OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
LLM_MODEL=claude-opus-4-6
