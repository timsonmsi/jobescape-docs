# ============================================================
# DocEscape Ops — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# -----------------------------------------------------------
# Google OAuth2 Credentials
# Get Client ID & Secret from Google Cloud Console > APIs & Services > Credentials
# Run `node scripts/get-token.mjs` once to get your REFRESH_TOKEN
# -----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# -----------------------------------------------------------
# Google Sheets
# -----------------------------------------------------------
# Main spreadsheet ID (from the URL: /spreadsheets/d/<ID>/edit)
SHEETS_ID=1v4L5NnADW9MlGmu_WcLD9mO_-YaAjqEO6iiN6Z-p36A

# Separate spreadsheet for logs (NDA Agreements, LegalReviews tabs)
LOGS_SHEETS_ID=

# -----------------------------------------------------------
# Google Drive
# -----------------------------------------------------------
# Root folder for employee invoice subfolders
# https://drive.google.com/drive/folders/1KJICCvdiBnisRpoH077W99V-SW0jSAml
DRIVE_INVOICES_ROOT_FOLDER_ID=1KJICCvdiBnisRpoH077W99V-SW0jSAml

# NDA DOCX templates folder
DRIVE_NDA_TEMPLATES_FOLDER_ID=

# -----------------------------------------------------------
# LLM for Legal Review
# -----------------------------------------------------------
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o

# -----------------------------------------------------------
# Authentication (NextAuth)
# -----------------------------------------------------------
# Full URL of your deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000
# Random secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Google Sheets ID containing the Users tab (email | password | role)
USERS_SHEETS_ID=
